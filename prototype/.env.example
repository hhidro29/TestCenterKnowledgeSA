# Hosted model provider. Set `groq` to use Qwen through Groq.
AI_PROVIDER=groq
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# GPT remains unavailable until GPT_ACTIVE_UNTIL is manually set to a future
# ISO timestamp. Use a timestamp four hours ahead for a controlled test window.
OPENAI_API_KEY=
GPT_MODEL=gpt-5-mini
GPT_ACTIVE_UNTIL=

# Render/Railway/etc. inject PORT automatically. Local default:
PORT=4310
HOST=0.0.0.0
MAX_REQUESTS_PER_MINUTE=30
