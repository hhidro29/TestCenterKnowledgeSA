# Default hosted model provider. Use `groq` for Qwen or `gemini` for Gemini.
AI_PROVIDER=openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

OPENAI_API_KEY=
GPT_MODEL=gpt-5-mini

# Render/Railway/etc. inject PORT automatically. Local default:
PORT=4310
HOST=0.0.0.0
MAX_REQUESTS_PER_MINUTE=30
