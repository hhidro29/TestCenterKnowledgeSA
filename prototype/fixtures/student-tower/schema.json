{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "student-tower-fixture.schema.json",
  "title": "Student Tower Synthetic Fixture",
  "type": "object",
  "required": ["fixture_version", "students", "scenarios"],
  "properties": {
    "fixture_version": { "type": "string" },
    "students": {
      "type": "array",
      "items": { "$ref": "#/$defs/student" }
    },
    "scenarios": {
      "type": "array",
      "items": { "$ref": "#/$defs/scenario" }
    }
  },
  "$defs": {
    "choice": {
      "type": "object",
      "required": ["priority", "university", "program", "route", "simulation"],
      "properties": {
        "priority": { "type": "integer", "minimum": 1 },
        "university": { "type": "string" },
        "program": { "type": "string" },
        "route": { "type": "string" },
        "reference": {
          "type": "object",
          "required": ["entity_status", "source_label", "source_url", "simulation_note"],
          "properties": {
            "entity_status": { "enum": ["real_entity", "synthetic_entity"] },
            "source_label": { "type": "string" },
            "source_url": { "type": "string", "format": "uri" },
            "simulation_note": { "type": "string" }
          },
          "additionalProperties": false
        },
        "simulation": {
          "type": "object",
          "required": ["latest_score", "target_score", "student_percentile", "reference_percentile", "comparison_participants", "data_quality"],
          "properties": {
            "latest_score": { "type": ["number", "null"] },
            "target_score": { "type": ["number", "null"] },
            "student_percentile": { "type": ["number", "null"] },
            "reference_percentile": { "type": ["number", "null"] },
            "comparison_participants": { "type": ["integer", "null"], "minimum": 0 },
            "data_quality": { "enum": ["good", "limited", "very_limited", "missing"] },
            "score_trend": { "enum": ["up", "stable", "down", "unknown"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "student": {
      "type": "object",
      "required": ["student_id", "checkpoint", "admission_route", "choices", "profiling", "parent_context", "previous_decisions", "previous_actions"],
      "properties": {
        "student_id": { "type": "string" },
        "student_name": { "type": "string" },
        "checkpoint": { "enum": ["PROFILING", "TO_CHECKPOINT_1", "TO_CHECKPOINT_2", "FINAL_CHECKPOINT"] },
        "admission_route": { "type": "string" },
        "school": {
          "type": ["object", "null"],
          "properties": {
            "name": { "type": "string" },
            "province": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "profile": {
          "type": ["object", "null"],
          "properties": {
            "persona_status": { "enum": ["synthetic_persona", "real_profile"] },
            "age": { "type": ["integer", "null"], "minimum": 15, "maximum": 25 },
            "grade": { "type": ["string", "null"] },
            "city": { "type": ["string", "null"] },
            "academic_track": { "type": ["string", "null"] },
            "strengths": { "type": "array", "items": { "type": "string" } },
            "interests": { "type": "array", "items": { "type": "string" } },
            "motivation": { "type": ["string", "null"] },
            "learning_pattern": { "type": ["string", "null"] },
            "decision_style": { "type": ["string", "null"] },
            "family_context": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "data_note": { "type": "string" },
        "choices": { "type": "array", "items": { "$ref": "#/$defs/choice" } },
        "profiling": { "type": "object" },
        "parent_context": { "type": "object" },
        "previous_decisions": { "type": "array" },
        "previous_actions": { "type": "array" },
        "active_workflows": {
          "type": "array",
          "items": { "$ref": "#/$defs/workflow" }
        }
      },
      "additionalProperties": false
    },
    "scenario": {
      "type": "object",
      "required": ["scenario_id", "title", "student_id", "purpose", "turns", "expected_behaviors", "expected_state"],
      "properties": {
        "scenario_id": { "type": "string" },
        "title": { "type": "string" },
        "student_id": { "type": "string" },
        "purpose": { "type": "string" },
        "turns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["speaker", "message"],
            "properties": {
              "speaker": { "enum": ["SA", "student", "parent"] },
              "message": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "expected_behaviors": { "type": "array", "items": { "type": "string" } },
        "expected_state": { "type": "string" },
        "expected_outcome": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "required": ["workflow_id", "title", "status", "trigger", "objective", "owner", "participants", "next_action", "success_criteria", "allowed_outcomes"],
      "properties": {
        "workflow_id": { "type": "string" },
        "title": { "type": "string" },
        "status": { "enum": ["NEEDS_ACTION", "CONSULTATION_PREP", "CONSULTATION_IN_PROGRESS", "STRUCTURING_INSIGHT", "DRAFT_DECISION", "WAITING_FOR_SA_CONFIRMATION", "WAITING_FOR_CLARIFICATION", "WORKFLOW_UPDATED", "COMPLETED"] },
        "current_step": { "type": "string" },
        "trigger": { "type": "string" },
        "objective": { "type": "string" },
        "owner": { "type": "string" },
        "participants": { "type": "array", "items": { "type": "string" } },
        "consultation_focus": { "type": "array", "items": { "type": "string" } },
        "missing_information": { "type": "array", "items": { "type": "string" } },
        "next_action": { "type": ["string", "null"] },
        "success_criteria": { "type": "array", "items": { "type": "string" } },
        "allowed_outcomes": { "type": "array", "items": { "type": "string" } },
        "raw_consultation_note": { "type": "string" },
        "confirmed_insight": { "type": "string" },
        "draft_decision": { "type": "object" },
        "decision": { "type": "object" },
        "action_plan": { "type": ["object", "null"] },
        "updated_at": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
